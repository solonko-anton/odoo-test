<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_route_form" model="ir.ui.view">
        <field name="name">logistics.route.form</field>
        <field name="model">logistics.route</field>
        <field name="arch" type="xml">
            <form string="Маршрут">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="carrier_id"/>
                        <field name="vehicle_id"/>
                    </group>
                    <notebook>
                        <page string="Замовлення">
                            <field name="order_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="total_weight"/>
                                    <field name="total_volume"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="total_weight"/>
                        <field name="total_volume"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_route_tree" model="ir.ui.view">
        <field name="name">logistics.route.tree</field>
        <field name="model">logistics.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="vehicle_id"/>
                <field name="total_weight"/>
                <field name="total_volume"/>
            </tree>
        </field>
    </record>
</odoo>