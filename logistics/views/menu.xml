<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions -->
    <record id="logistics_order_action" model="ir.actions.act_window">
        <field name="name">Замовлення</field>
        <field name="res_model">logistics.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="logistics_vehicle_action" model="ir.actions.act_window">
        <field name="name">Автомобілі</field>
        <field name="res_model">logistics.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="logistics_route_action" model="ir.actions.act_window">
        <field name="name">Маршрути</field>
        <field name="res_model">logistics.route</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="logistics_product_action" model="ir.actions.act_window">
        <field name="name">Товар</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="logistics_partner_action" model="ir.actions.act_window">
        <field name="name">Контрагенти</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_logistics_root" name="Логістика" sequence="10"/>

    <menuitem id="menu_logistics_order" name="Замовлення" parent="menu_logistics_root"
              action="logistics_order_action" sequence="10"/>

    <menuitem id="menu_logistics_vehicle" name="Автомобілі" parent="menu_logistics_root"
              action="logistics_vehicle_action" sequence="20"/>

    <menuitem id="menu_logistics_route" name="Маршрути" parent="menu_logistics_root"
              action="logistics_route_action" sequence="30"/>

    <menuitem id="menu_logistics_product" name="Товари" parent="menu_logistics_root"
          action="logistics_product_action" sequence="40"/>

    <menuitem id="logistics_menu_partner" name="Контрагенти" parent="menu_logistics_root"
              action="logistics_partner_action" sequence="50"/>

</odoo>
